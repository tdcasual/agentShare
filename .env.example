# =============================================================================
# VaultGate Local Development
# =============================================================================
# Usage: cp .env.example .env && docker compose up -d --build
# All values below are safe for local development only. Change before deploying.
# =============================================================================

# ---- Environment ----
APP_ENV=development

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/vaultgate
POSTGRES_DB=vaultgate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- VaultGate Security Settings ----
# IMPORTANT: Generate strong keys for production!
#
# Generate ENCRYPTION_KEY (32 bytes for AES-256, base64-encoded):
#   python3 -c 'import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
ENCRYPTION_KEY=8aVLomFNGRuMm6HRwGk5+lkEfuVWHsSAjOGkp7/N8uI=
ENCRYPTION_ACTIVE_KEY_ID=current
ENCRYPTION_KEYRING={}
SESSION_SECURE=false
IDEMPOTENCY_RETENTION_DAYS=7
MAX_REQUEST_BODY_BYTES=2097152

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Ports ----
API_PORT=8000
WEB_PORT=3000

# ---- Web UI ----
VAULTGATE_API_URL=http://api:8000
