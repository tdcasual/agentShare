# =============================================================================
# VaultGate Production
# =============================================================================
# Usage: cp .env.production.example .env.production
#        docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# ALL values below must be changed before deploying.
# =============================================================================

# ---- Environment ----
APP_ENV=production

# ---- Database ----
# Optional: leave DATABASE_URL unset for the default same-stack Postgres wiring.
# The production compose file derives it from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# Only set DATABASE_URL explicitly when pointing the API at a different database host.
DATABASE_URL=
POSTGRES_DB=vaultgate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

# ---- Encryption ----
# AES-256-GCM key. Generate with:
#   python -c 'import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ---- Session ----
# Secret for signing web UI session cookies. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=replace-with-strong-session-secret
SESSION_SECURE=true

# ---- CORS ----
# Comma-separated list of allowed origins for the web UI.
CORS_ALLOWED_ORIGINS=https://vaultgate.example.com

# ---- Security Headers ----
# HSTS max-age in seconds (default: 1 year)
HSTS_MAX_AGE=31536000
# Set to true to log CSP violations without blocking (useful for rollout)
CSP_REPORT_ONLY=false

# ---- Token defaults ----
TOKEN_TTL_DAYS=30

# ---- Observability ----
METRICS_ENABLED=true
