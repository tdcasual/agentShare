{
  "name": "control-plane-v3",
  "engines": {
    "node": ">=22.0.0"
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "audit:dependencies": "node ./scripts/audit-dependencies.mjs",
    "start": "node ./scripts/start-standalone.mjs",
    "start:next": "next start",
    "lint": "npx eslint src test playwright*.config.ts --ext .ts,.tsx",
    "lint:fix": "npx eslint src test playwright*.config.ts --ext .ts,.tsx --fix",
    "typecheck": "rm -f tsconfig.tsbuildinfo && rm -rf .next/types && next typegen && tsc --noEmit --incremental false",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\" \"playwright*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\" \"playwright*.config.ts\"",
    "generate:api-types": "cd ../.. && PYTHONPATH=apps/api .venv/bin/python apps/control-plane-v3/scripts/export-openapi.py | apps/control-plane-v3/node_modules/.bin/openapi-typescript /dev/stdin -o apps/control-plane-v3/src/lib/generated-api.ts && cd apps/control-plane-v3 && ./node_modules/.bin/prettier --write src/lib/generated-api.ts",
    "check:api-types": "npm run generate:api-types && git diff --exit-code -- src/lib/generated-api.ts",
    "test": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "lucide-react": "^0.460.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.5.0"
  },
  "overrides": {
    "js-yaml": "^4.2.1",
    "sharp": "^0.35.0",
    "next": {
      "postcss": ">=8.5.10"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.10"
  }
}
