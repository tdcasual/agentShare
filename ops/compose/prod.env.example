# =============================================================================
# Production — docker compose -f docker-compose.prod.yml up
# =============================================================================
# ALL values with "replace-with-*" MUST be changed before deployment.
# =============================================================================

# ---- Public Routing ----
PUBLIC_HOST=vaultgate.example.com
APP_BASE_URL=https://vaultgate.example.com
CORS_ALLOWED_ORIGINS=https://vaultgate.example.com
ACME_EMAIL=ops@example.com

# ---- Data Store (REQUIRED) ----
POSTGRES_DB=vaultgate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
# File-based secret alternative. Leave POSTGRES_PASSWORD empty when using it.
POSTGRES_PASSWORD_FILE=
POSTGRES_DATA_LOCATION=postgres-data
POSTGRES_WAL_ARCHIVE_LOCATION=postgres-wal-archive
POSTGRES_ARCHIVE_TIMEOUT_SECONDS=300
POSTGRES_INITDB_ARGS=--data-checksums
# Optional: leave DATABASE_URL unset for the default same-stack Postgres wiring.
# The API safely constructs it from the structured POSTGRES_* settings, including reserved characters.
# Only set DATABASE_URL explicitly when pointing the API at a different database host; URL-encode it.
DATABASE_URL=
DATABASE_URL_FILE=

# ---- Application Secrets (REQUIRED) ----
ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key
ENCRYPTION_KEY_FILE=
ENCRYPTION_ACTIVE_KEY_ID=current
# Optional JSON object of legacy key ids to base64 keys, for example:
# {"old":"replace-with-old-32-byte-base64-key"}
ENCRYPTION_KEYRING={}
ENCRYPTION_KEYRING_FILE=
BOOTSTRAP_TOKEN=replace-with-random-one-time-bootstrap-token
BOOTSTRAP_TOKEN_FILE=
# Host directory mounted read-only at /run/secrets/vaultgate in API and PostgreSQL.
VAULTGATE_SECRETS_DIR=./.vaultgate-secrets

# ---- Optional ----
TRUSTED_PROXY_CIDRS=172.30.0.2/32
LAST_USED_WRITE_INTERVAL_SECONDS=300
CREDENTIAL_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
IDEMPOTENCY_RETENTION_DAYS=7
MAX_REQUEST_BODY_BYTES=2097152
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# Optional recovery and availability policy
ENABLE_LOGICAL_BACKUP=false
REQUIRE_POSTGRES_REPLICA=false
POSTGRES_MAX_DISK_PERCENT=80
POSTGRES_MAX_INODE_PERCENT=80
