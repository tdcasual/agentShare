# =============================================================================
# Production — docker compose -f docker-compose.prod.yml up
# =============================================================================
# ALL values with "replace-with-*" MUST be changed before deployment.
# =============================================================================

# ---- Public Routing ----
APP_ENV=production
PUBLIC_HOST=vaultgate.example.com
APP_BASE_URL=https://vaultgate.example.com
ACME_EMAIL=ops@example.com
NEXT_PUBLIC_API_BASE_URL=https://vaultgate.example.com
NEXT_PUBLIC_SESSION_COOKIE_NAME=vaultgate_session

# ---- Data Store (REQUIRED) ----
POSTGRES_DB=vaultgate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
# Optional: leave DATABASE_URL unset for the default same-stack Postgres wiring.
# The production compose file will derive it from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
# Only set DATABASE_URL explicitly when pointing the API at a different database host.
DATABASE_URL=

# ---- Application Secrets (REQUIRED) ----
ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key
SESSION_SECRET=replace-with-long-random-value
SESSION_SECURE=true

# ---- Container Images (REQUIRED) ----
API_IMAGE=ghcr.io/example/vaultgate-api:latest
WEB_IMAGE=ghcr.io/example/vaultgate-web:latest

# ---- Optional ----
HSTS_MAX_AGE=31536000
CSP_REPORT_ONLY=false
