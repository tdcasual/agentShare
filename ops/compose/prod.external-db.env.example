# Production environment for docker-compose.prod.external-db.yml.
# Use a managed PostgreSQL service with synchronous multi-AZ durability and TLS validation.

PUBLIC_HOST=vaultgate.example.com
APP_BASE_URL=https://vaultgate.example.com
CORS_ALLOWED_ORIGINS=https://vaultgate.example.com
ACME_EMAIL=ops@example.com

# Configure either DATABASE_URL or DATABASE_URL_FILE, never both.
# Require TLS and certificate validation in the managed provider connection string.
DATABASE_URL=postgresql://vaultgate:replace-with-password@managed-db.example.com:5432/vaultgate?sslmode=verify-full
DATABASE_URL_FILE=
API_REPLICAS=2

ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key
ENCRYPTION_KEY_FILE=
ENCRYPTION_ACTIVE_KEY_ID=current
ENCRYPTION_KEYRING={}
ENCRYPTION_KEYRING_FILE=
BOOTSTRAP_TOKEN=replace-with-random-one-time-bootstrap-token
BOOTSTRAP_TOKEN_FILE=
VAULTGATE_SECRETS_DIR=./.vaultgate-secrets

TRUSTED_PROXY_CIDRS=172.30.0.2/32
# Session cookie name and lifetime in seconds; defaults match the API.
SESSION_COOKIE_NAME=vaultgate_session
SESSION_TTL_SECONDS=43200
# Allow credentialed CORS requests (browser session cookies).
CORS_ALLOW_CREDENTIALS=true
# Login rate limit: maximum attempts per window in seconds.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
LAST_USED_WRITE_INTERVAL_SECONDS=300
CREDENTIAL_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
IDEMPOTENCY_RETENTION_DAYS=7
MAX_REQUEST_BODY_BYTES=2097152
MIGRATION_LOCK_TIMEOUT_SECONDS=120
# Web same-origin proxy upstream timeout in milliseconds. The proxy code
# defaults to 15000; the production compose files raise it to 30000.
VAULTGATE_API_TIMEOUT_MS=30000
